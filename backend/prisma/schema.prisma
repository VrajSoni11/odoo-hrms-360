// PeoplePay360 — Prisma schema
// Phase 0: Role, Department, Employee, User
// Phase 1: WorkingSchedule, ScheduleLine, Contract (+ overlap constraint, see afterMigrate.js)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Phase 0 ----------

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // Admin, HR Manager, HR Payroll User, HR Payroll Manager, Employee
  users User[]

  @@map("roles")
}

model Department {
  id                 Int          @id @default(autoincrement())
  name               String
  parentDepartmentId Int?
  parentDepartment   Department?  @relation("DeptHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[] @relation("DeptHierarchy")
  employees          Employee[]
  contracts          Contract[]
  createdAt          DateTime     @default(now())

  @@map("departments")
}

model Employee {
  id             Int              @id @default(autoincrement())
  name           String
  workEmail      String           @unique
  phone          String?
  departmentId   Int?
  department     Department?      @relation(fields: [departmentId], references: [id])
  managerId      Int?
  manager        Employee?        @relation("ManagerReports", fields: [managerId], references: [id])
  reports        Employee[]       @relation("ManagerReports")
  jobPosition    String?
  status         String           @default("active") // active/inactive
  employeeType   String           @default("full_time") // full_time/part_time/contract
  photoUrl       String?
  scheduleId     Int?
  schedule       WorkingSchedule? @relation(fields: [scheduleId], references: [id])
  createdAt      DateTime         @default(now())

  user      User?
  contracts Contract[]
  attendance Attendance[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  payrunEmployees    PayrunEmployee[]
  payslips           Payslip[]
  payrollWarnings    PayrollWarning[]

  @@map("employees")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  employeeId   Int?      @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  attendanceCorrections Attendance[] @relation("AttendanceCorrections")
  allocationApprovals TimeOffAllocation[] @relation("AllocationApprovals")
  timeOffDecisions    TimeOffRequest[]    @relation("TimeOffDecisions")
  refreshTokens RefreshToken[]
  createdPayruns Payrun[]
  approvedPayslips Payslip[] @relation("PayslipApprovals")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@map("users")
}

// ---------- Phase 1 ----------

model WorkingSchedule {
  id               Int            @id @default(autoincrement())
  name             String
  type             String         @default("full_time") // full_time/part_time
  totalWeeklyHours Decimal        @default(0) @db.Decimal(5, 2) // auto-computed server-side, never entered manually
  lines            ScheduleLine[]
  employees        Employee[]
  contracts        Contract[]
  createdAt        DateTime       @default(now())

  @@map("working_schedules")
}

model ScheduleLine {
  id           Int             @id @default(autoincrement())
  scheduleId   Int
  schedule     WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek    Int             // 0 = Monday ... 6 = Sunday
  startTime    String          // "09:00" (24h HH:mm)
  endTime      String          // "17:00" (24h HH:mm)
  breakMinutes Int             @default(0)

  @@map("schedule_lines")
}

model Contract {
  id                Int              @id @default(autoincrement())
  employeeId        Int
  employee          Employee         @relation(fields: [employeeId], references: [id])
  departmentId      Int?
  department        Department?      @relation(fields: [departmentId], references: [id])
  jobPosition       String?
  scheduleId        Int?
  schedule          WorkingSchedule? @relation(fields: [scheduleId], references: [id])
  startDate         DateTime         @db.Date
  endDate           DateTime?        @db.Date
  wage              Decimal          @db.Decimal(12, 2)
  state             String           @default("draft") // draft/active/expired/cancelled
  createdAt         DateTime         @default(now())
  salaryStructureId Int?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  payslips Payslip[]

  @@map("contracts")
}

model Attendance {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id])
  checkIn       DateTime
  checkOut      DateTime?
  workedHours   Decimal?  @db.Decimal(8, 2)
  status        String    @default("checked_in")
  source        String    @default("self")
  note          String?
  correctedById Int?
  correctedBy   User?     @relation("AttendanceCorrections", fields: [correctedById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([employeeId, checkIn])
  @@map("attendance")
}

model TimeOffType {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  unit              String              @default("days")
  requiresAllocation Boolean            @default(true)
  requiresApproval  Boolean             @default(true)
  affectsPayroll    Boolean             @default(false)
  allocations       TimeOffAllocation[]
  requests          TimeOffRequest[]
  createdAt         DateTime            @default(now())

  @@map("time_off_types")
}

model TimeOffAllocation {
  id              Int        @id @default(autoincrement())
  employeeId      Int
  employee        Employee   @relation(fields: [employeeId], references: [id])
  timeOffTypeId   Int
  timeOffType     TimeOffType @relation(fields: [timeOffTypeId], references: [id])
  allocatedAmount Decimal    @db.Decimal(8, 2)
  remainingAmount Decimal    @db.Decimal(8, 2)
  status          String     @default("draft")
  approvedById    Int?
  approvedBy      User?      @relation("AllocationApprovals", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())

  requests TimeOffRequest[]

  @@index([employeeId, timeOffTypeId, status])
  @@map("time_off_allocations")
}

model TimeOffRequest {
  id              Int               @id @default(autoincrement())
  employeeId      Int
  employee        Employee           @relation(fields: [employeeId], references: [id])
  timeOffTypeId   Int
  timeOffType     TimeOffType        @relation(fields: [timeOffTypeId], references: [id])
  allocationId    Int?
  allocation      TimeOffAllocation? @relation(fields: [allocationId], references: [id])
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  requestedAmount Decimal            @db.Decimal(8, 2)
  reason          String?
  status          String             @default("pending")
  decidedById     Int?
  decidedBy       User?              @relation("TimeOffDecisions", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())

  @@index([employeeId, status])
  @@map("time_off_requests")
}

model SalaryStructure {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  isActive  Boolean      @default(true)
  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("salary_structures")
}

model SalaryRule {
  id               Int             @id @default(autoincrement())
  structureId      Int
  structure        SalaryStructure  @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name             String
  code             String
  category         String
  sequence         Int             @default(10)
  computationMethod String
  amount           Decimal?        @db.Decimal(12, 2)
  percentageOf     String?
  percentageRate   Decimal?        @db.Decimal(7, 4)
  formula          String?
  isActive         Boolean         @default(true)
  payslipLines     PayslipLine[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([structureId, code])
  @@index([structureId, sequence])
  @@map("salary_rules")
}

model Payrun {
  id               Int              @id @default(autoincrement())
  name             String
  salaryStructureId Int
  salaryStructure  SalaryStructure  @relation(fields: [salaryStructureId], references: [id])
  periodStart      DateTime         @db.Date
  periodEnd        DateTime         @db.Date
  status           String           @default("draft")
  createdById      Int
  createdBy        User             @relation(fields: [createdById], references: [id])
  employees        PayrunEmployee[]
  payslips         Payslip[]
  warnings         PayrollWarning[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("payruns")
}

model PayrunEmployee {
  payrunId   Int
  payrun     Payrun   @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  included   Boolean  @default(true)

  @@id([payrunId, employeeId])
  @@map("payrun_employees")
}

model Payslip {
  id           Int           @id @default(autoincrement())
  payrunId     Int
  payrun       Payrun        @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employeeId   Int
  employee     Employee      @relation(fields: [employeeId], references: [id])
  contractId   Int
  contract     Contract      @relation(fields: [contractId], references: [id])
  periodStart  DateTime      @db.Date
  periodEnd    DateTime      @db.Date
  workedDays   Decimal       @db.Decimal(8, 2)
  status       String        @default("draft")
  grossAmount  Decimal       @db.Decimal(12, 2)
  netAmount    Decimal       @db.Decimal(12, 2)
  pdfUrl       String?
  lines        PayslipLine[]
  approvedById Int?
  approvedBy   User?         @relation("PayslipApprovals", fields: [approvedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([payrunId, employeeId])
  @@index([employeeId, periodStart, periodEnd])
  @@map("payslips")
}

model PayslipLine {
  id          Int        @id @default(autoincrement())
  payslipId   Int
  payslip     Payslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryRuleId Int
  salaryRule  SalaryRule @relation(fields: [salaryRuleId], references: [id])
  ruleName    String
  category    String
  amount      Decimal    @db.Decimal(12, 2)
  sequence    Int

  @@index([payslipId, sequence])
  @@map("payslip_lines")
}

model PayrollWarning {
  id         Int       @id @default(autoincrement())
  payrunId   Int
  payrun     Payrun    @relation(fields: [payrunId], references: [id], onDelete: Cascade)
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  type       String
  message    String
  severity   String    @default("high")
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([payrunId, resolved, severity])
  @@map("payroll_warnings")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

